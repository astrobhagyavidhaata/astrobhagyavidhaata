{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astrobhagyavidhaata",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "NODE_ENV": "production"
  },
  "assets": {
    "directory": "./worker-assets/",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/healthz"
    ],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
